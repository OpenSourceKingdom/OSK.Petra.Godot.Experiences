<Project Sdk="Godot.NET.Sdk/4.4.0">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<LangVersion>14</LangVersion>
		<IncludeBuildOutput>false</IncludeBuildOutput>

		<Description>Provides an implementation for an game experience (quest, objective) tracking, configuration and setup for Godot within the Petra game framework.</Description>
		<PackageTags>OpenSourceKingdom, OpenSource, Petra, Game, Framework, Suite, Tool, Objective, Narrative, Story, Quest, Mission, Manage, Godot</PackageTags>
		<Title>OSK.Petra.Godot.Experiences</Title>
		<Authors>BlankDev117</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/OpenSourceKingdom/OSK.Petra.Godot.Experiences</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Required Godot injection -->
	<ItemGroup>
		<Compile Update="**\*.cs" Pack="true" PackagePath="godot\%(RecursiveDir)%(Filename)%(Extension)" />
		<None Include="..\OSK.Petra.Godot.targets" Pack="true" PackagePath="buildTransitive\$(MSBuildProjectName).targets" />
	</ItemGroup>
  <ItemGroup>
    <PackageReference Include="OSK.Petra.Experiences" Version="0.1.0" />
    <PackageReference Include="OSK.Petra.Godot.Primitives" Version="0.3.2" />
  </ItemGroup>

</Project>
